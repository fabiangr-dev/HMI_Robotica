  <property name="styleSheet">
   <string notr="true">* {
  font-family: "Segoe UI", "Calibri", Arial, sans-serif;
  font-size: 10pt;
}

QMainWindow, #centralwidget {
  background-color: #050B14;
  color: #EAF4FF;
}

#frameTopBar {
  background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
    stop:0 #081426, stop:0.55 #0B1B30, stop:1 #07111F);
  border: 1px solid #21476D;
  border-left: 3px solid #55B7FF;
  border-radius: 10px;
}

#labelTitle {
  color: #F4FAFF;
  font-size: 13pt;
  font-weight: 700;
}

#labelBroker {
  color: #8BA8C3;
  font-size: 9pt;
}

QTabWidget::pane {
  border: 1px solid #18334F;
  background-color: #07111F;
  border-radius: 8px;
  top: 6px;
}

QTabBar {
  background-color: #050B14;
}

QTabBar::tab {
  background-color: #0A1524;
  color: #91A9C0;
  padding: 9px 20px;
  margin: 3px 2px;
  border: 1px solid #17334F;
  border-radius: 7px;
  font-weight: 600;
  font-size: 10pt;
}

QTabBar::tab:selected {
  background-color: #123B64;
  color: #F5FBFF;
  border: 1px solid #48AFFF;
  border-bottom: 2px solid #66C4FF;
}

QTabBar::tab:hover:!selected {
  background-color: #0D2239;
  color: #DDEEFF;
  border-color: #2C638E;
}

QGroupBox {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
    stop:0 #0B1727, stop:1 #07111E);
  border: 1px solid #1E466B;
  border-radius: 10px;
  margin-top: 20px;
  padding: 22px 16px 16px 16px;
  font-weight: 700;
  font-size: 10.5pt;
  color: #DDEEFF;
}

QGroupBox::title {
  subcontrol-origin: margin;
  subcontrol-position: top left;
  left: 14px;
  top: 6px;
  padding: 2px 8px;
  color: #63BEFF;
  background-color: #07111F;
}

QLabel {
  color: #C7D8E8;
  font-weight: 400;
  padding: 1px 0;
}

QPushButton {
  background-color: #0C1B2C;
  color: #EAF5FF;
  border: 1px solid #2B587E;
  border-radius: 7px;
  padding: 8px 16px;
  font-weight: 600;
  min-height: 18px;
}

QPushButton:hover {
  background-color: #123253;
  border-color: #55B7FF;
  color: #FFFFFF;
}

QPushButton:pressed {
  background-color: #0A223A;
  border-color: #83D0FF;
}

QLineEdit, QComboBox {
  background-color: #050C16;
  border: 1px solid #274A69;
  border-radius: 6px;
  padding: 6px 10px;
  color: #E8F4FF;
  min-height: 18px;
  selection-background-color: #1C6EA8;
  selection-color: #FFFFFF;
}

QLineEdit:focus, QComboBox:focus {
  border: 1px solid #55B7FF;
  background-color: #071321;
}

QComboBox::drop-down {
  border: none;
  width: 22px;
}

QSlider::groove:horizontal {
  height: 5px;
  background: #1A3045;
  border: 1px solid #234A69;
  border-radius: 3px;
}

QSlider::handle:horizontal {
  background: #65C2FF;
  width: 16px;
  height: 16px;
  margin: -6px 0;
  border-radius: 8px;
  border: 2px solid #DDF3FF;
}

QSlider::sub-page:horizontal {
  background: #2489C7;
  border-radius: 3px;
}

QProgressBar {
  background-color: #0A1929;
  border: 1px solid #1D4262;
  border-radius: 4px;
  min-height: 8px;
  max-height: 8px;
  text-align: center;
  color: transparent;
}

QProgressBar::chunk {
  background-color: #43A9ED;
  border-radius: 3px;
}

QListWidget, QTableWidget, QTextEdit {
  background-color: #060E18;
  border: 1px solid #1E4668;
  border-radius: 8px;
  color: #DCEBFA;
  gridline-color: #122B42;
  selection-background-color: #123E63;
  selection-color: #FFFFFF;
  padding: 4px;
}

QListWidget::item {
  padding: 8px 6px;
  border-radius: 5px;
  margin: 1px 0;
}

QListWidget::item:selected {
  background-color: #123E63;
  color: #FFFFFF;
  border-left: 2px solid #5CC0FF;
}

QTableWidget::item {
  padding: 6px;
}

QHeaderView::section {
  background-color: #0C2742;
  color: #BFE5FF;
  padding: 7px;
  border: none;
  border-bottom: 1px solid #2B6A96;
  font-weight: 600;
  font-size: 9.5pt;
}

QTextEdit {
  font-family: "Consolas", "Courier New", monospace;
  font-size: 9pt;
  color: #8FB1CC;
}

QStatusBar {
  background-color: #050B14;
  color: #7F9AB3;
  border-top: 1px solid #17334F;
}

#labelInfoManual, #labelInfoEnsenanza {
  background-color: #0B2238;
  color: #7AC9FF;
  font-weight: 600;
  padding: 10px 14px;
  border-radius: 7px;
  border: 1px solid #1F5B83;
  border-left: 4px solid #55B7FF;
}

#labelPasswordError {
  background-color: #29151C;
  color: #FF9DB0;
  padding: 8px 12px;
  border-radius: 7px;
  border: 1px solid #713247;
}

#labelLogNota {
  color: #718DA7;
  font-style: italic;
}

QScrollBar:vertical {
  background: #07111F;
  width: 10px;
  margin: 2px;
}
QScrollBar::handle:vertical {
  background: #214B70;
  min-height: 30px;
  border-radius: 5px;
}
QScrollBar::handle:vertical:hover {
  background: #3C8CC2;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
  height: 0px;
}
QToolTip {
  background-color: #0A1B2D;
  color: #EAF6FF;
  border: 1px solid #3A8AC0;
  padding: 5px;
}
